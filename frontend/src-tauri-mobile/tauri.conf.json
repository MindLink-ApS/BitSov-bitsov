{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/dev/crates/tauri-schema-generator/schemas/config.schema.json",
  "productName": "BitSov",
  "version": "0.1.0",
  "identifier": "network.bitsov.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* https://127.0.0.1:* wss://127.0.0.1:*; font-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["apk", "aab"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "16.0",
      "entitlements": "./ios/BitSov.entitlements"
    }
  },
  "plugins": {
    "shell": {
      "all": false,
      "execute": false,
      "sidecar": false,
      "open": false
    },
    "notification": {
      "all": false
    }
  }
}
