# /etc/bitsov-display/display.toml
# Every key is optional. Unknown keys are refused so typos are not silently ignored.

# auto | ssd1306 | sh1106 | st7789 | ili9341 | fbdev
# auto tries: a non-HDMI framebuffer, then an I2C OLED at 0x3C/0x3D, then
# guesses st7789 if /dev/spidev0.0 exists. Pin the driver once --probe shows the panel.
driver = "auto"

# Panel size as you look at it. Defaults: OLED 128x64, st7789 240x240, ili9341 320x240.
# A 240x320 ST7789 is fine: give width = 240, height = 320.
# width = 240
# height = 240

# Quarter turns clockwise, 0..3.
rotate = 0

# I2C OLED
# i2c_port = 1
# i2c_address = 0x3C

# SPI TFT (BCM pin numbers; -1 means not wired)
# spi_port = 0
# spi_device = 0
# spi_speed_hz = 32000000
# gpio_dc = 24
# gpio_rst = 25
# gpio_backlight = 18
# backlight_active_low = false

# Framebuffer (3.5" fbtft / DRM panels); auto picks the first non-HDMI one.
# fb_device = "/dev/fb1"

# The node's konsensus.toml. Read-only; only prices, [api].listen_addr and
# [node].hosted_by are ever parsed. install.sh fills this in.
# node_config = "/home/<user>/.local/share/konsensus/konsensus.toml"

# Override the API port taken from [api].listen_addr (always dialled on 127.0.0.1).
# api_port = 3141

interval_secs = 8
screens = ["logo", "status", "prices", "host"]
